summary: TMT/FMF plan for running rpminspect.

discover:
  how: shell
  tests:
    - name: rpminspect
      framework: shell
      test: rpminspect_runner.sh $TASK_ID
      result: custom
      duration: 720m

description: |
  Runs rpminspect tests in Fedora CI — https://github.com/fedora-ci/rpminspect-pipeline.

provision:
  how: container
  # source: https://github.com/fedora-ci/rpminspect-runner
  image: quay.io/fedoraci/rpminspect:b577fb6

prepare:
  - how: install
    copr: "@rpminspect/latest"
  - how: install
    copr: "@osci/fedora-license-data"
  - how: shell
    script: |
      # If needed change this to a specific pinned NVR from
      # https://copr.fedorainfracloud.org/coprs/g/rpminspect/latest/builds/
      # https://copr.fedorainfracloud.org/coprs/g/osci/fedora-license-data/builds/
      dnf upgrade -y rpminspect rpminspect-data-fedora fedora-license-data
  - how: shell
    script: |
      echo "TASK_ID=$KOJI_TASK_ID" >> "$TMT_PLAN_ENVIRONMENT_FILE"
      echo "DIST_GIT_BRANCH=$@{dist-git-branch}" >> "$TMT_PLAN_ENVIRONMENT_FILE"
      echo "RPMINSPECT_YAML_LOOKUP_STRATEGY=commit" >> "$TMT_PLAN_ENVIRONMENT_FILE"

execute:
  how: tmt
